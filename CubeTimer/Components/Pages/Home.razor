@page "/"
@inject IJSRuntime JSRuntime

<!-- Session and Puzzle Selection -->
<div>
    <label for="sessionSelect">Select Session:</label>
    <select value="@selectedSession" @onchange="e => OnSessionChanged(e.Value?.ToString())">
        @foreach (var session in sessions.Where(s => s != "Favorites")) 
        {
            <option value="@session">@session</option>
        }
    </select>

    <label for="puzzleSelect">Select Puzzle:</label>
    <select value="@selectedPuzzle" @onchange="e => OnPuzzleChanged(e.Value?.ToString())">
        @foreach(var puzzle in puzzleTypes)
        {
            <option value="@puzzle">@puzzle</option>
        }
    </select>
</div>

<!-- Scramble Display -->
<div class="scramble-display">
    <p>@CurrentScramble</p>
</div>

<!-- Timer Display -->
<div class="timer-display">@ElapsedTime</div>

<div class="averages">
    <div>Ao5: @Ao5Display</div>
    <div>Ao12: @Ao12Display</div>
</div>

<!-- Recorded Times Panel -->
<div class="times-panel">
    <h2>Recorded Times</h2>
    @if (recordedTimes.Count == 0)
    {
        <p>No times recorded yet for this session.</p>
    }
    else
    {
        <ul>
            @foreach (var record in Enumerable.Reverse(recordedTimes))
            {
                <li>
                    <strong>Scramble:</strong> @record.Scramble <br />
                    <strong>Puzzle:</strong> @record.Puzzle <br />
                    <strong>Time:</strong> @record.Time
                    @if (!string.IsNullOrEmpty(record.Fault))
                    {
                        <span> (Fault: @record.Fault)</span>
                    }
                    @(record.IsFavorited ? " ⭐️" : "") <!-- Show star if favorited -->
                    <br />
                    <button @onclick="() => DeleteTime(record)">Delete</button>
                    <button class="@GetFavoriteButtonClass(record)" @onclick="() => ToggleFavorite(record)">
                        @GetFavoriteButtonText(record)
                    </button>
                    <!-- Fault Buttons -->
                    <button @onclick="() => ApplyPlus2(record)">+2</button>
                    <button @onclick="() => ApplyPlus4(record)">+4</button>
                    <button @onclick="() => ApplyDNF(record)">DNF</button>
                    <button @onclick="() => CancelFault(record)">Cancel Fault</button>
                </li>
            }
        </ul>
    }
</div>

@code {
    private bool _isRunning = false;
    private DateTime _startTime;
    private TimeSpan _elapsed = TimeSpan.Zero;
    private List<Record> recordedTimes = new();
    private List<string> sessions = new();
    private string selectedSession = "Default";

    // List of available puzzle types (2x2, 3x3, 4x4, 5x5, etc.)
    private List<string> puzzleTypes = new() { "2x2", "3x3", "4x4", "5x5" };
    private string selectedPuzzle = "3x3";

    private string Ao5Display = "N/A";
    private string Ao12Display = "N/A";
    private string CurrentScramble = string.Empty;

    private string ElapsedTime
    {
        get
        {
            if (_elapsed.TotalHours >= 1)
                return _elapsed.ToString(@"hh\:mm\:ss\.fff");
            else if (_elapsed.TotalMinutes >= 1)
                return _elapsed.ToString(@"mm\:ss\.fff");
            else
                return _elapsed.ToString(@"ss\.fff");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LoadSessions();

        // Ensure 'Favorites' session always exists
        if (!sessions.Contains("Favorites"))
        {
            sessions.Add("Favorites");
            SaveSessions();
        }

        selectedSession = sessions.FirstOrDefault() ?? "Default";
        LoadSessionData();
        LoadFavoritesStatus();

        // Generate scramble for the default puzzle
        CurrentScramble = GenerateScramble(selectedPuzzle);

        // JS interop for space bar detection
        await JSRuntime.InvokeVoidAsync("initializeKeyListener", DotNetObjectReference.Create(this));
    }

    // Generate scramble according to puzzle type
    private static string GenerateScramble(string puzzle)
    {
        // For demonstration, we'll use simple examples:
        // You can replace these with actual scramble generators 
        // that differ in length/moves for each puzzle.
        var moves3x3 = new[] { "R", "L", "U", "D", "F", "B" };
        var modifiers = new[] { "", "'", "2" };

        var moves2x2 = new[] { "R", "U", "F" }; // small set
        var moves4x4 = new[] { "R", "r", "U", "u", "F", "f", "L", "l" }; // Example
        var moves5x5 = new[] { "R", "r", "R2", "U", "u", "U2", "F", "f", "F2" }; // Example

        List<string> scramble = new();

        switch (puzzle)
        {
            case "2x2":
                // Generate a short scramble
                for (int i = 0; i < 9; i++)
                {
                    scramble.Add(moves2x2[Random.Shared.Next(moves2x2.Length)] 
                                 + modifiers[Random.Shared.Next(modifiers.Length)]);
                }
                break;

            case "4x4":
                // Generate a 4x4 scramble with wide moves, example length 40
                for (int i = 0; i < 40; i++)
                {
                    var move = moves4x4[Random.Shared.Next(moves4x4.Length)];
                    // 4x4 often includes wide moves (r, u, l, f, etc.)
                    scramble.Add(move + (move.Length == 1 ? modifiers[Random.Shared.Next(modifiers.Length)] : ""));
                }
                break;

            case "5x5":
                // Generate a 5x5 scramble, example length 60
                for (int i = 0; i < 60; i++)
                {
                    var move = moves5x5[Random.Shared.Next(moves5x5.Length)];
                    scramble.Add(move);
                }
                break;

            default: // "3x3"
                var previousMove = "";
                for (int i = 0; i < 20; i++)
                {
                    string move;
                    do
                    {
                        move = moves3x3[Random.Shared.Next(moves3x3.Length)];
                    } while (move == previousMove);

                    previousMove = move;
                    scramble.Add(move + modifiers[Random.Shared.Next(modifiers.Length)]);
                }
                break;
        }

        return string.Join(" ", scramble);
    }

    // Start/Stop Timer
    private void StartTimer()
    {
        if (!_isRunning)
        {
            _elapsed = TimeSpan.Zero;
            _isRunning = true;
            _startTime = DateTime.Now;
            _ = UpdateTimerAsync();
        }
    }

    private void StopTimer()
    {
        if (_isRunning)
        {
            _isRunning = false;
            // Record time, including puzzle type
            RecordTime(CurrentScramble, ElapsedTime, selectedPuzzle);
            // Generate new scramble based on the currently selected puzzle
            CurrentScramble = GenerateScramble(selectedPuzzle);
        }
        StateHasChanged();
    }

    private async Task UpdateTimerAsync()
    {
        while (_isRunning)
        {
            _elapsed = DateTime.Now - _startTime;
            StateHasChanged();
            await Task.Delay(50);
        }
    }

    private void RecordTime(string scramble, string time, string puzzle)
    {
        recordedTimes.Add(new Record 
        { 
            Scramble = scramble, 
            Time = time, 
            Puzzle = puzzle,
            Fault = string.Empty 
        });
        SaveSessionData();
        UpdateAverages();
    }

    private void DeleteTime(Record record)
    {
        recordedTimes.Remove(record);
        SaveSessionData();
        UpdateAverages();
    }

    // Puzzle changed
    private void OnPuzzleChanged(string? newPuzzle)
    {
        selectedPuzzle = newPuzzle ?? "3x3";
        // Optionally generate a new scramble immediately
        CurrentScramble = GenerateScramble(selectedPuzzle);
    }

    // Session changed
    private async void OnSessionChanged(string? newValue)
    {
        selectedSession = newValue ?? "Default";
        LoadSessionData();
        LoadFavoritesStatus();
        // Remove focus from the dropdown (optional)
        await JSRuntime.InvokeVoidAsync("blurElement");
        StateHasChanged();
    }

    // Fault Management
    private void ApplyFault(Record record, string fault)
    {
        record.Fault = fault;
        SaveSessionData();
        UpdateAverages();
        StateHasChanged();
    }

    private void CancelFault(Record record)
    {
        record.Fault = string.Empty;
        SaveSessionData();
        UpdateAverages();
        StateHasChanged();
    }

    private void ApplyPlus2(Record record) => ApplyFault(record, "+2");
    private void ApplyPlus4(Record record) => ApplyFault(record, "+4");
    private void ApplyDNF(Record record) => ApplyFault(record, "DNF");

    // Favorites
    private void ToggleFavorite(Record record)
    {
        if (!record.IsFavorited)
        {
            AddToFavorites(record);
            record.IsFavorited = true;
        }
        else
        {
            RemoveFromFavorites(record);
            record.IsFavorited = false;
        }

        SaveFavoritesStatus();
        StateHasChanged();
    }

    private void AddToFavorites(Record record)
    {
        var json = Preferences.Get("Favorites", string.Empty);
        var favorites = string.IsNullOrEmpty(json)
            ? new List<Record>()
            : System.Text.Json.JsonSerializer.Deserialize<List<Record>>(json) ?? new List<Record>();

        favorites.Add(new Record 
        { 
            Scramble = record.Scramble, 
            Time = record.Time, 
            Puzzle = record.Puzzle, 
            IsFavorited = true 
        });

        Preferences.Set("Favorites", System.Text.Json.JsonSerializer.Serialize(favorites));
    }

    private void RemoveFromFavorites(Record record)
    {
        var json = Preferences.Get("Favorites", string.Empty);
        var favorites = string.IsNullOrEmpty(json)
            ? new List<Record>()
            : System.Text.Json.JsonSerializer.Deserialize<List<Record>>(json) ?? new List<Record>();

        var recordToRemove = favorites.FirstOrDefault(f => f.Scramble == record.Scramble 
                                                           && f.Time == record.Time
                                                           && f.Puzzle == record.Puzzle);
        if (recordToRemove != null)
        {
            favorites.Remove(recordToRemove);
        }

        Preferences.Set("Favorites", System.Text.Json.JsonSerializer.Serialize(favorites));
    }

    private void LoadFavoritesStatus()
    {
        var json = Preferences.Get("Favorites", string.Empty);
        var favorites = string.IsNullOrEmpty(json)
            ? new List<Record>()
            : System.Text.Json.JsonSerializer.Deserialize<List<Record>>(json) ?? new List<Record>();

        foreach (var record in recordedTimes)
        {
            if (favorites.Any(f => f.Scramble == record.Scramble 
                                && f.Time == record.Time
                                && f.Puzzle == record.Puzzle))
            {
                record.IsFavorited = true;
            }
        }
    }

    private void SaveFavoritesStatus()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(recordedTimes.Where(r => r.IsFavorited));
        Preferences.Set("Favorites", json);
    }

    // Calculate Averages
    private void UpdateAverages()
    {
        if (recordedTimes.Count >= 5)
        {
            var lastFive = recordedTimes.Skip(Math.Max(0, recordedTimes.Count - 5)).ToList();
            Ao5Display = CalculateWCAAverageAO5(lastFive);
        }
        else
        {
            Ao5Display = "N/A";
        }

        if (recordedTimes.Count >= 12)
        {
            var lastTwelve = recordedTimes.Skip(Math.Max(0, recordedTimes.Count - 12)).ToList();
            Ao12Display = CalculateWCAAverageAO12(lastTwelve);
        }
        else
        {
            Ao12Display = "N/A";
        }
    }

    private string CalculateWCAAverageAO5(List<Record> times)
    {
        // Convert to numeric times, accounting for faults
        var timeValues = times
            .Select(t =>
            {
                if (t.Fault == "DNF") return double.NaN;
                if (!double.TryParse(t.Time, out var baseTime)) return double.NaN;

                return t.Fault switch
                {
                    "+2" => baseTime + 2,
                    "+4" => baseTime + 4,
                    _ => baseTime
                };
            })
            .OrderBy(t => double.IsNaN(t) ? double.MaxValue : t)
            .ToList();

        // WCA rules for Ao5
        if (timeValues.Count(v => !double.IsNaN(v)) < 3) return "DNF";
        if (timeValues.Count(v => double.IsNaN(v)) > 1) return "DNF";

        var validTimes = timeValues.Where(v => !double.IsNaN(v)).ToList();
        // Remove best and worst
        validTimes.RemoveAt(0);
        validTimes.RemoveAt(validTimes.Count - 1);

        return validTimes.Average().ToString("F3");
    }

    private string CalculateWCAAverageAO12(List<Record> times)
    {
        // Convert to numeric times, accounting for faults
        var timeValues = times
            .Select(t =>
            {
                if (t.Fault == "DNF") return double.NaN;
                if (!double.TryParse(t.Time, out var baseTime)) return double.NaN;

                return t.Fault switch
                {
                    "+2" => baseTime + 2,
                    "+4" => baseTime + 4,
                    _ => baseTime
                };
            })
            .OrderBy(t => double.IsNaN(t) ? double.MaxValue : t)
            .ToList();

        // WCA rules for Ao12
        if (timeValues.Count(v => !double.IsNaN(v)) < 10) return "DNF";
        if (timeValues.Count(v => double.IsNaN(v)) > 2) return "DNF";

        var validTimes = timeValues.Where(v => !double.IsNaN(v)).ToList();
        // Remove best and worst
        validTimes.RemoveAt(0);
        validTimes.RemoveAt(validTimes.Count - 1);

        return validTimes.Average().ToString("F3");
    }

    private string GetFavoriteButtonClass(Record record) => record.IsFavorited ? "favorited" : "not-favorited";

    private string GetFavoriteButtonText(Record record) => record.IsFavorited ? "Unfavorite" : "Favorite";

    // Session Persistence
    private void LoadSessions()
    {
        var json = Preferences.Get("sessions", string.Empty);
        sessions = string.IsNullOrEmpty(json) 
            ? new List<string> { "Default" } 
            : System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new List<string> { "Default" };
    }

    private void SaveSessions()
    {
        Preferences.Set("sessions", System.Text.Json.JsonSerializer.Serialize(sessions));
    }

    private void LoadSessionData()
    {
        var json = Preferences.Get(selectedSession, string.Empty);
        recordedTimes = string.IsNullOrEmpty(json)
            ? new List<Record>()
            : System.Text.Json.JsonSerializer.Deserialize<List<Record>>(json) ?? new List<Record>();
        UpdateAverages();
    }

    private void SaveSessionData()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(recordedTimes);
        Preferences.Set(selectedSession, json);
    }

    [JSInvokable]
    public void OnSpacePressed()
    {
        if (_isRunning) StopTimer();
        else StartTimer();
    }

    // Extended Record to hold Puzzle type
    public class Record
    {
        public string Scramble { get; set; } = string.Empty;
        public string Time { get; set; } = string.Empty;
        public string Puzzle { get; set; } = "3x3"; // default
        public bool IsFavorited { get; set; } = false;
        public string Fault { get; set; } = string.Empty;
    }
}
